DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clausulazos?schema=public"
JWT_SECRET="change_this_secret_in_production"
PORT=3000

# CORS: comma-separated list of extra allowed origins (prod Vercel URL +
# common local dev ports are already allowed by default, you only need
# this for anything else, e.g. a custom domain).
CORS_ORIGINS=""

# WebAuthn / Passkeys. Defaults already match production
# (clausulazos.vercel.app) — only needed to override for a custom domain
# or to add local dev origins beyond the defaults.
WEBAUTHN_RP_ID="clausulazos.vercel.app"
WEBAUTHN_RP_NAME="Clausulazos"
WEBAUTHN_ORIGINS="https://clausulazos.vercel.app,http://localhost:5000"

# Optional: if set, GET /fantasy/sync requires this value in an
# `x-sync-secret` header. Leave unset to keep the current behaviour (no
# auth needed, required for the existing GitHub Actions cron unless you
# also update the workflow to send the header).
FANTASY_SYNC_SECRET=""
