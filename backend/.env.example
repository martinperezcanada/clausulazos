# Copy to .env and fill in real values locally. Never commit real secrets.

# PostgreSQL connection string used by Prisma.
DATABASE_URL=

# Signing secret for JWT access tokens.
JWT_SECRET=

# Comma-separated list of allowed CORS origins (e.g. Flutter Web dev server).
CORS_ORIGINS=

# Port the NestJS server listens on (Render sets this automatically).
PORT=

# WebAuthn / Passkeys.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=
WEBAUTHN_ORIGINS=

# LALIGA Fantasy OAuth refresh token used to keep the sync token alive.
LALIGA_REFRESH_TOKEN=

# Optional shared secret checked on GET /fantasy/sync (the GitHub Actions
# cron calls it without one by default — only needed if you opt into it).
FANTASY_SYNC_SECRET=

# --- Firebase Cloud Messaging (server-side / Firebase Admin SDK) ---
# From a Firebase service account JSON (Firebase Console → Project
# Settings → Service accounts → Generate new private key). NEVER commit
# that JSON file — only these three values go into env vars.
# FIREBASE_PRIVATE_KEY must keep its "\n" sequences escaped as literal
# backslash-n when pasted into a single-line env var; the backend
# converts them back to real newlines at startup (see
# src/notifications/firebase-admin.service.ts).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
