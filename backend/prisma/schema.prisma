generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClauseStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// PENDING: detected from LALIGA, not yet confirmed by either participant; doesn't count toward the limits.
// CLAUSE:  confirmed as a real clausulazo; counts toward the limits.
// AGREED:  confirmed by both participants as an agreed transfer; never counts.
// Existing rows default to CLAUSE (migration backfill).
enum ClauseClassification {
  PENDING
  CLAUSE
  AGREED
}

// PENDING:  registered, awaiting admin review. Excluded from `GET /users`, but can still log in.
// APPROVED: default for accounts that existed before this feature (migration backfill) and for
//           accounts an admin approves.
// REJECTED: rejected by an admin; excluded from the manager list like PENDING.
enum UserApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
laligaUserId String? @unique
  status    UserApprovalStatus @default(APPROVED)
  clausesMade     Clause[] @relation("ClausesMade")
  clausesReceived Clause[] @relation("ClausesReceived")
  passkeys        PasskeyCredential[]
  notifications   Notification[]
  notificationDevices NotificationDevice[]

  @@map("users")
}

// A clausulazo occupies one "performed" slot for `fromUser` and one "received" slot for `toUser`
// for 7 x 24h from createdAt.
model Clause {
  id               String       @id @default(uuid())
  laligaActivityId String?      @unique
  playerMasterId   String?
  // Best effort: read from the LALIGA activity payload when present, null otherwise.
  playerName       String?
  // Official player picture from LALIGA's player endpoint (`playerMaster.images`), null when unknown.
  playerImageUrl   String?
  amount           Int?

  fromUserId String
  toUserId   String
  createdAt  DateTime     @default(now())
  expiresAt  DateTime
  status     ClauseStatus @default(ACTIVE)
  cancelledAt DateTime?

  // Defaults to CLAUSE so existing and manually created clauses keep counting; the LALIGA sync sets
  // PENDING for newly detected movements.
  classification   ClauseClassification?  
  // Each participant's own vote. The movement only becomes AGREED when both sides vote AGREED.
  fromConfirmation ClauseClassification?
  toConfirmation   ClauseClassification?

  fromUser User @relation("ClausesMade", fields: [fromUserId], references: [id])
  toUser   User @relation("ClausesReceived", fields: [toUserId], references: [id])
  notifications Notification[]

  @@index([fromUserId])
  @@index([toUserId])
  @@map("clauses")
}

// Persisted "avisar a..." reminders (Activity screen). The push itself is sent by NotificationsService.
enum NotificationType {
  CLAUSE_CONFIRMATION_REMINDER
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  message   String
  clauseId  String?
  createdAt DateTime         @default(now())
  readAt    DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  clause Clause? @relation(fields: [clauseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("notifications")
}

// One row per device/browser registered for FCM push; a user can have several. The token is unique,
// so re-registering (rotated token, another account on the same device) reassigns the row.
model NotificationDevice {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notification_devices")
}

// WebAuthn credential. Only what is needed to verify signatures is stored (public key and signature
// counter), nothing biometric.
model PasskeyCredential {
  id           String    @id @default(uuid())
  userId       String
  // Base64url credential id, unique; used to find the key to verify on login.
  credentialId String    @unique
  publicKey    Bytes
  // Signature counter for replay detection: must increase on every use (stays 0 for authenticators
  // without counters, such as synced passkeys).
  counter      Int       @default(0)
  transports   String[]  @default([])
  // 'singleDevice' | 'multiDevice' (per @simplewebauthn/server)
  deviceType   String?
  backedUp     Boolean   @default(false)
  // User-facing label, e.g. "iPhone de Martín", to tell passkeys apart.
  name         String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkey_credentials")
}

enum WebAuthnChallengeType {
  REGISTRATION
  AUTHENTICATION
}

// Single-use, expiring challenges for registration and login. `userId` is null for discoverable
// (usernameless) logins. A challenge is consumed on first use (`usedAt`) to prevent replay.
model WebAuthnChallenge {
  id        String                @id @default(uuid())
  userId    String?
  challenge String                @unique
  type      WebAuthnChallengeType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  @@index([challenge])
  @@map("webauthn_challenges")
}
model FantasyAuthToken {
  id                    String   @id @default("laliga")
  refreshToken          String
  accessToken           String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  updatedAt             DateTime @updatedAt

  @@map("fantasy_auth_tokens")
}

// Singleton row tracking the "Fantasy Sync" cron. `lastSuccessAt` only moves on runs that complete;
// failed runs update `lastFailureAt`/`lastError` only, so the dashboard keeps showing the last good sync.
model FantasySyncStatus {
  id            String    @id @default("fantasy")
  lastAttemptAt DateTime?
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  lastStatus    String?
  lastError     String?
  lastSummary   Json?
  updatedAt     DateTime  @updatedAt

  @@map("fantasy_sync_status")
}
