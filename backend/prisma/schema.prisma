generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClauseStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// PENDING: detected automatically from LALIGA, not yet confirmed by either
//          participant — does not count toward the 2-slot limits.
// CLAUSE:  confirmed as a real clausulazo — counts toward the limits.
// AGREED:  confirmed by BOTH participants as a pacted transfer — never
//          counts toward the limits, regardless of the 7-day window.
// Existing rows created before this feature default to CLAUSE via the
// migration backfill, so old clauses keep counting exactly as before.
enum ClauseClassification {
  PENDING
  CLAUSE
  AGREED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
laligaUserId String? @unique
  clausesMade     Clause[] @relation("ClausesMade")
  clausesReceived Clause[] @relation("ClausesReceived")
  passkeys        PasskeyCredential[]

  @@map("users")
}

// A Clause ("clausulazo") occupies one "performed" slot for `fromUser`
// and one "received" slot for `toUser`, for exactly 7 x 24h from createdAt.
model Clause {
  id               String       @id @default(uuid())
  laligaActivityId String?      @unique
  playerMasterId   String?
  // Best-effort, read defensively from the LALIGA activity payload if
  // present (falls back to null — never blocks saving the clause itself).
  playerName       String?
  amount           Int?

  fromUserId String
  toUserId   String
  createdAt  DateTime     @default(now())
  expiresAt  DateTime
  status     ClauseStatus @default(ACTIVE)
  cancelledAt DateTime?

  // Classification workflow (see ClauseClassification above). Defaults to
  // CLAUSE so existing/manually-created clauses keep counting exactly as
  // before; the LALIGA sync explicitly overrides this to PENDING for
  // newly-detected movements.
  classification   ClauseClassification?  
  // Each participant's own vote on what the movement was. Only becomes
  // AGREED (excluded from stats) once BOTH sides independently confirm
  // AGREED — neither side can unilaterally remove a clause from the
  // limits by classifying it alone.
  fromConfirmation ClauseClassification?
  toConfirmation   ClauseClassification?

  fromUser User @relation("ClausesMade", fields: [fromUserId], references: [id])
  toUser   User @relation("ClausesReceived", fields: [toUserId], references: [id])

  @@index([fromUserId])
  @@index([toUserId])
  @@map("clauses")
}

// WebAuthn/Passkey credential. Only the pieces WebAuthn itself needs to
// verify future signatures are stored — never anything biometric. Face
// ID/Touch ID/PIN happen entirely on the user's device; the server only
// ever sees the public key and a signature counter.
model PasskeyCredential {
  id           String    @id @default(uuid())
  userId       String
  // Base64url credential ID reported by the authenticator — unique per
  // credential, used to look up which user/key to verify against on login.
  credentialId String    @unique
  publicKey    Bytes
  // Signature counter for replay-attack detection: must strictly increase
  // on every use (0 for authenticators that don't support counters, e.g.
  // many platform authenticators using cloud-synced passkeys).
  counter      Int       @default(0)
  transports   String[]  @default([])
  // 'singleDevice' | 'multiDevice' (per @simplewebauthn/server)
  deviceType   String?
  backedUp     Boolean   @default(false)
  // User-facing label, e.g. "iPhone de Martín" — set from the device/
  // browser at registration time so multiple passkeys stay distinguishable.
  name         String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkey_credentials")
}

enum WebAuthnChallengeType {
  REGISTRATION
  AUTHENTICATION
}

// Single-use, expiring challenges for both registration and login
// ceremonies. `userId` is null for a discoverable ("usernameless") login
// attempt, where we don't know who's authenticating until the assertion
// comes back. Rows are consumed (usedAt set) on first use and never reused
// — this is what prevents replay attacks against the challenge itself.
model WebAuthnChallenge {
  id        String                @id @default(uuid())
  userId    String?
  challenge String                @unique
  type      WebAuthnChallengeType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  @@index([challenge])
  @@map("webauthn_challenges")
}
model FantasyAuthToken {
  id                    String   @id @default("laliga")
  refreshToken          String
  accessToken           String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  updatedAt             DateTime @updatedAt

  @@map("fantasy_auth_tokens")
}
